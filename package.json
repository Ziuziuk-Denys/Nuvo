{
  "name": "nuvo",
  "version": "0.2.11-beta.5",
  "private": true,
  "type": "module",
  "description": "Nuvo, a local-first desktop music player",
  "author": {
    "name": "Denys Ziuziuk",
    "email": "denys.ziuziuk.w@gmail.com"
  },
  "homepage": "https://nuvo.quest",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ziuziuk-Denys/nuvo"
  },
  "license": "AGPL-3.0-or-later",
  "desktopName": "quest.nuvo.Nuvo.desktop",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "pnpm core:build:dev && vite",
    "dev:x11": "pnpm core:build:dev && NUVO_X11=1 vite",
    "core:build": "cargo build --release --manifest-path core/Cargo.toml -p nuvo-server",
    "core:build:dev": "cargo build --manifest-path core/Cargo.toml -p nuvo-server",
    "core:test": "cargo test --manifest-path core/Cargo.toml && cargo clippy --manifest-path core/Cargo.toml --all-targets -- -D warnings",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm build && pnpm check:deps && pnpm test && pnpm test:scripts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm core:build:dev && pnpm build && vitest run --config vitest.e2e.config.ts",
    "electron:build": "pnpm core:build && pnpm core:stage && pnpm panel:pack && tsc -b && vite build && electron-builder",
    "electron:build:linux": "pnpm core:build && pnpm core:stage && pnpm panel:pack && tsc -b && vite build && electron-builder --linux",
    "electron:build:win": "pnpm core:build && pnpm core:stage && tsc -b && vite build && electron-builder --win",
    "electron:build:mac": "pnpm core:build && pnpm core:stage && tsc -b && vite build && electron-builder --mac",
    "panel:pack": "node scripts/pack-panel-widgets.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "check:deps": "node scripts/unused-deps.mjs --fail",
    "core:stage": "node scripts/stage-core.mjs"
  },
  "build": {
    "appId": "quest.nuvo.Nuvo",
    "productName": "Nuvo",
    "copyright": "Copyright 2026 Denys Ziuziuk",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "protocols": [
      {
        "name": "Nuvo link",
        "schemes": [
          "nuvo"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Ziuziuk-Denys",
        "repo": "nuvo"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icons/*.png",
      "build/icons/tray/*.png"
    ],
    "extraResources": [
      {
        "from": "THIRD-PARTY-NOTICES",
        "to": "THIRD-PARTY-NOTICES"
      }
    ],
    "electronLanguages": [
      "en-US",
      "ru"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "linux": {
      "executableName": "nuvo",
      "syncDesktopName": true,
      "maintainer": "Denys Ziuziuk <denys.ziuziuk.w@gmail.com>",
      "vendor": "Denys Ziuziuk",
      "synopsis": "Local-first music player",
      "description": "Local-first music player",
      "icon": "build/icons",
      "category": "AudioVideo;Audio;Player",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "extraResources": [
        {
          "from": "core/target/dist/linux-${arch}/nuvo-core",
          "to": "bin/nuvo-core"
        },
        {
          "from": "desktop/dist/nuvo-panel@nuvo.quest.shell-extension.zip",
          "to": "desktop/dist/nuvo-panel@nuvo.quest.shell-extension.zip"
        },
        {
          "from": "desktop/plasma/quest.nuvo.panel",
          "to": "desktop/plasma/quest.nuvo.panel"
        },
        {
          "from": "desktop/waybar",
          "to": "desktop/waybar"
        }
      ],
      "desktop": {
        "entry": {
          "GenericName": "Music Player",
          "Keywords": "music;player;audio;lyrics;playlist;",
          "SingleMainWindow": "true",
          "X-GNOME-UsesNotifications": "true"
        }
      }
    },
    "deb": {
      "packageName": "nuvo",
      "packageCategory": "sound",
      "priority": "optional",
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libasound2 | libasound2t64",
        "libssl3 | libssl3t64",
        "zlib1g"
      ],
      "recommends": [
        "gnome-keyring | kwalletmanager"
      ],
      "description": "Nuvo plays your music from your own folders and from the streams you link to it, with synced lyrics, an equalizer and recommendations worked out on your computer. The library stays encrypted on your computer and needs no account.",
      "fpm": [
        "build/linux/quest.nuvo.Nuvo.metainfo.xml=/usr/share/metainfo/quest.nuvo.Nuvo.metainfo.xml",
        "build/icons/nuvo.svg=/usr/share/icons/hicolor/scalable/apps/nuvo.svg",
        "build/icons/nuvo.svg=/usr/share/icons/hicolor/scalable/apps/quest.nuvo.Nuvo.svg"
      ]
    },
    "rpm": {
      "packageName": "nuvo",
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "(libXtst or libXtst6)",
        "xdg-utils",
        "at-spi2-core",
        "(libuuid or libuuid1)",
        "(libsecret or libsecret-1-0)",
        "(mesa-libgbm or libgbm1)",
        "(alsa-lib or libasound2)",
        "libcrypto.so.3()(64bit)",
        "(zlib or zlib-ng-compat or libz1)"
      ],
      "description": "Nuvo plays your music from your own folders and from the streams you link to it, with synced lyrics, an equalizer and recommendations worked out on your computer. The library stays encrypted on your computer and needs no account.",
      "fpm": [
        "build/linux/quest.nuvo.Nuvo.metainfo.xml=/usr/share/metainfo/quest.nuvo.Nuvo.metainfo.xml",
        "build/icons/nuvo.svg=/usr/share/icons/hicolor/scalable/apps/nuvo.svg",
        "build/icons/nuvo.svg=/usr/share/icons/hicolor/scalable/apps/quest.nuvo.Nuvo.svg"
      ]
    },
    "win": {
      "executableName": "nuvo",
      "icon": "build/icons/nuvo.ico",
      "target": [
        "nsis",
        "zip"
      ],
      "extraResources": [
        {
          "from": "core/target/dist/win-${arch}/nuvo-core.exe",
          "to": "bin/nuvo-core.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Nuvo",
      "uninstallDisplayName": "Nuvo",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icons/nuvo.ico",
      "uninstallerIcon": "build/icons/nuvo.ico"
    },
    "mac": {
      "icon": "build/icons/nuvo.icns",
      "category": "public.app-category.music",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Nuvo listens through the microphone only while you ask it to recognise a song."
      },
      "target": [
        "dmg",
        "zip"
      ],
      "extraResources": [
        {
          "from": "core/target/dist/mac-${arch}/nuvo-core",
          "to": "bin/nuvo-core"
        }
      ]
    },
    "dmg": {
      "title": "Nuvo ${version}",
      "iconSize": 96,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 180,
          "type": "file"
        },
        {
          "x": 400,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "devDependencies": {
    "@braccato/core": "^1.4.0",
    "@braccato/parsers": "^0.2.1",
    "@tanstack/react-virtual": "^3.13.23",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "bgutils-js": "4.0.3",
    "electron": "^44.10.2",
    "electron-builder": "^26.18.0",
    "framer-motion": "^12.38.0",
    "googlevideo": "5.0.0",
    "jsdom": "~30.0.1",
    "next-themes": "^0.4.6",
    "oxlint": "^1.87.0",
    "playwright-core": "1.64.1",
    "prettier": "^3.9.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^7.18.2",
    "typescript": "^5",
    "vite": "^8.3.6",
    "vite-plugin-electron": "^1.1.1",
    "vitest": "^4.1.12",
    "youtubei.js": "18.1.0",
    "zustand": "^5.0.12"
  },
  "dependencies": {
    "electron-updater": "6.8.12",
    "tiny-pinyin": "^1.3.2"
  }
}
